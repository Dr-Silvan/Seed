<Window x:Class="Seed.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Seed.Controls"
        Width="230" Height="270" AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <Border Background="#EFFFfcF4" CornerRadius="28" Padding="12" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <controls:PlantView x:Name="Plant" Margin="12,4,12,-5"/>
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock x:Name="DayText" FontSize="20" FontWeight="Bold" Foreground="#24352D" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LevelText" FontSize="12" Foreground="#6F7F76" HorizontalAlignment="Center"/>
            </StackPanel>
            <Button Content="×" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="#20FFFFFF" Foreground="#6F7F76" Click="CloseWidget"/>
        </Grid>
    </Border>
</Window>
