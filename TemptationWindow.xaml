<Window x:Class="Seed.TemptationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="지금 버티기" Width="760" Height="650"
        WindowStartupLocation="CenterOwner" Background="#18382C">
    <Grid Margin="34">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="지금 여기에서, 60초만." Foreground="White" FontSize="28" FontWeight="Bold"/>
            <TextBlock x:Name="GuideMessage" Foreground="#CDE0D3" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="#214B3A" CornerRadius="24" Margin="0,0,10,0" Padding="22">
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="210" Height="210" HorizontalAlignment="Center">
                        <Ellipse x:Name="BreathCircle" Fill="#76B58E" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="BreathText" Text="시작" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CountdownText" Text="60" Foreground="#D8EADF" FontSize="15" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="StartButton" Content="60초 호흡 시작" Background="#F1C66D" Foreground="#24352D" Click="StartBreathing"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#214B3A" CornerRadius="24" Margin="10,0,0,0" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="무엇이 시작점이었나요?" Foreground="#CDE0D3"/>
                        <ComboBox x:Name="TriggerBox" Margin="0,8,0,18" Padding="9"/>
                        <TextBlock Text="방향을 바꿀 작은 행동" Foreground="#CDE0D3"/>
                        <TextBlock x:Name="ActionText" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,18"/>
                        <TextBlock Text="추천" Foreground="#CDE0D3" Margin="0,0,0,7"/>
                        <ItemsControl x:Name="ResourceList"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2">
            <TextBlock Text="링크는 기본 브라우저에서 열립니다." Foreground="#9BB7A7" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="아직 어려워요" Background="#315744" Foreground="White" Click="SaveNotYet"/>
                <Button Content="이번 파도를 넘겼어요" Background="#F1C66D" Foreground="#24352D" Margin="8,0,0,0" Click="SaveOvercame"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
