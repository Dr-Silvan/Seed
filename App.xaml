<Application x:Class="Seed.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="Ink" Color="#24352D"/>
        <SolidColorBrush x:Key="Muted" Color="#6F7F76"/>
        <SolidColorBrush x:Key="Cream" Color="#F6F2E8"/>
        <SolidColorBrush x:Key="Card" Color="#FFFCF4"/>
        <SolidColorBrush x:Key="Green" Color="#39745A"/>
        <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/></Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#E8EFE8"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Application.Resources>
</Application>
