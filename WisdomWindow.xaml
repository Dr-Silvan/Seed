<Window x:Class="Seed.WisdomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="오늘의 성찰" Width="620" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F6F2E8">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="오늘의 성찰" Foreground="#39745A" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="QuoteText" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold"
                       LineHeight="34" Foreground="#24352D" Margin="0,14,0,13"/>
            <TextBlock x:Name="AttributionText" Foreground="#6F7F76" FontSize="14"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#EAEFE6" CornerRadius="18" Padding="18" Margin="0,24,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="더 깊이 살펴보기" FontWeight="SemiBold" Foreground="#24352D"/>
                <TextBlock Text="이 문장은 원문의 직역 인용이 아니라 해당 사상과 구절에서 영감을 받아 정리한 성찰문입니다."
                           TextWrapping="Wrap" Foreground="#6F7F76" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="웹에서 읽기  ↗" Click="OpenWeb"/>
            <Button Content="관련 영상 보기  ▶" Background="#39745A" Foreground="White" Margin="9,0,0,0" Click="OpenVideo"/>
        </StackPanel>
    </Grid>
</Window>
