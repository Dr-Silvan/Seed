<Window x:Class="Seed.FailureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실패 기록" Width="520" Height="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F6F2E8">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="무슨 일이 있었나요?" FontSize="26" FontWeight="Bold" Foreground="#24352D"/>
            <TextBlock Text="자책을 위한 질문이 아니라, 다음 환경을 바꾸기 위한 기록이에요." Foreground="#6F7F76" TextWrapping="Wrap" Margin="0,7,0,20"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <WrapPanel x:Name="ReasonPanel"/>
                <TextBlock Text="짧은 메모 (선택)" Foreground="#6F7F76" Margin="0,20,0,7"/>
                <TextBox x:Name="NoteBox" AcceptsReturn="True" Height="100" Padding="10" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" Click="Cancel"/>
            <Button Content="기록하고 다시 심기" Background="#39745A" Foreground="White" Margin="8,0,0,0" Click="Confirm"/>
        </StackPanel>
    </Grid>
</Window>
